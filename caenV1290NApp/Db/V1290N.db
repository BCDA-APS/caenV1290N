record(mbbo, "$(P)$(R):AcquisitionMode") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0))ACQUISITION_MODE")
    field(ZRVL, 0)
    field(ZRST, "Continuous")
    field(ONVL, 1)
    field(ONST, "Trigger Matching")
    field(FLNK, "$(P)$(R):AcquisitionModeRBV.PROC")
}
record(mbbi, "$(P)$(R):AcquisitionModeRBV") {
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(INP,  "@asyn($(PORT),$(ADDR=0))ACQUISITION_MODE")
    field(ZRVL, 0)
    field(ZRST, "Continuous")
    field(ONVL, 1)
    field(ONST, "Trigger Matching")
}

record(mbbo, "$(P)$(R):EdgeDetectMode") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0))EDGE_DETECT_MODE")
    field(ZRVL, 0)
    field(ZRST, "Pair")
    field(ONVL, 1)
    field(ONST, "Trailing")
    field(TWVL, 2)
    field(TWST, "Leading")
    field(THVL, 3)
    field(THST, "Trailing & Leading")
    field(FLNK, "$(P)$(R):EdgeDetectModeRBV.PROC")
}
record(mbbi, "$(P)$(R):EdgeDetectModeRBV") {
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(INP,  "@asyn($(PORT),$(ADDR=0))EDGE_DETECT_MODE")
    field(ZRVL, 0)
    field(ZRST, "Pair")
    field(ONVL, 1)
    field(ONST, "Trailing")
    field(TWVL, 2)
    field(TWST, "Leading")
    field(THVL, 3)
    field(THST, "Trailing & Leading")
}

record(longout, "$(P)$(R):EnableAll") {
    field(VAL, 65535)
    field(OUT, "$(P)$(R):EnableBits.VAL PP")
}
record(longout, "$(P)$(R):DisableAll") {
    field(VAL, 0)
    field(OUT, "$(P)$(R):EnableBits.VAL PP")
}
# TODO: these should max out at 2^16
record(mbboDirect, "$(P)$(R):EnableBits") {
    field(DTYP, "asynUInt32Digital")
    field(NOBT, 16)
    field(OUT,  "@asynMask($(PORT),$(ADDR=0),0xFFFF,1)ENABLE_PATTERN")
    field(FLNK, "$(P)$(R):EnableBitsRBV.PROC")
}
record(mbbiDirect, "$(P)$(R):EnableBitsRBV") {
    field(DTYP, "asynUInt32Digital")
    field(NOBT, 16)
    field(PINI, "YES")
    field(INP,  "@asynMask($(PORT),$(ADDR=0),0xFFFF,1)ENABLE_PATTERN")
}

record(bo, "$(P)$(R):ReadTriggerConfig") {
    field(DTYP, "asynInt32")
    field(PINI, "YES")
    field(OUT, "@asyn($(PORT),$(ADDR=0))TRIGGER_CONFIG")
}

record(longout, "$(P)$(R):WindowWidth") {
    field(DTYP, "asynInt32")
    field(EGU, "25 ns")
    field(DRVH, 2088)
    field(DRVL, 1)
    field(OUT, "@asyn($(PORT),$(ADDR=0))WINDOW_WIDTH")
    field(FLNK, "$(P)$(R):ReadTriggerConfig.PROC")
}
record(longin, "$(P)$(R):WindowWidthRBV") {
    field(DTYP, "asynInt32")
    field(EGU, "25 ns")
    field(SCAN, "I/O Intr")
    field(INP, "@asyn($(PORT),$(ADDR=0))WINDOW_WIDTH")
}

record(longout, "$(P)$(R):WindowOffset") {
    field(DTYP, "asynInt32")
    field(EGU, "25 ns")
